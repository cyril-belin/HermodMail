---
import BrandMark from './BrandMark.astro';

interface Props {
  lang: 'en' | 'fr';
  BASE: string;
  t: any;
}
const { lang, BASE, t } = Astro.props;

const links = [
  { href: '#why', label: t.nav.problem },
  { href: '#how', label: t.nav.story },
  { href: '#webmail', label: t.nav.webmail },
  { href: '#mcp', label: t.nav.mcp },
  { href: '#permissions', label: t.nav.permissions },
  { href: '#developers', label: t.nav.developers },
];

const otherLang = lang === 'en' ? 'fr' : 'en';
const langHref = lang === 'en' ? `${BASE}/fr/` : BASE + '/';
const aria = lang === 'en' ? 'Switch to French' : 'Passer en anglais';
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={BASE + '/'} aria-label="HermodMail — home">
      <BrandMark />
      <span>HermodMail</span>
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <path d="M3 5.5h14M3 10h14M3 14.5h14" />
      </svg>
    </button>

    <nav class="nav" id="site-nav" aria-label="Main">
      {links.map((l) => <a class="nav-link" href={l.href}>{l.label}</a>)}
      <div class="nav-cta-row">
        <a class="btn btn-solid" href="https://github.com/cyril-belin/HermodMail" target="_blank" rel="noopener">
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          {t.nav.github}
        </a>
        <nav class="lang-switch" aria-label={aria}>
          <a href={BASE + '/'} data-lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
          <a href={`${BASE}/fr/`} data-lang="fr" aria-current={lang === 'fr' ? 'true' : undefined}>FR</a>
        </nav>
      </div>
    </nav>

    <div class="desktop-actions">
      <nav class="lang-switch" aria-label={aria}>
        <a href={BASE + '/'} data-lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        <a href={`${BASE}/fr/`} data-lang="fr" aria-current={lang === 'fr' ? 'true' : undefined}>FR</a>
      </nav>
      <a class="btn btn-solid" href="https://github.com/cyril-belin/HermodMail" target="_blank" rel="noopener">
        {t.nav.github}
      </a>
    </div>
  </div>
</header>

<style>
  .desktop-actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .nav-cta-row { display: none; }
  .desktop-actions .btn { display: inline-flex; }
  .nav > .btn,
  .nav > .lang-switch { display: none; }

  @media (max-width: 1050px) {
    .nav a.nav-link { margin-inline: auto; }
  }
  @media (max-width: 860px) {
    .desktop-actions { display: none; }
    .nav-cta-row {
      display: flex;
      gap: 0.7rem;
      align-items: center;
      padding-top: 1.1rem;
    }
    .nav-cta-row .btn { flex: 1; }
    .nav .lang-switch { display: inline-flex; margin-left: 0.6rem; }
  }
</style>
