---
interface Props { t: any; }
const { t } = Astro.props;
---

<section class="section models" id="models" aria-labelledby="models-title">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">{t.models.eyebrow}</p>
      <h2 id="models-title" class="h2">{t.models.title}</h2>
      <p class="lead">{t.models.lead}</p>
    </div>

    <div class="options reveal">
      {t.models.options.map((opt, i) => (
        <article class="card option" style={`--oi: ${i}`}>
          <h3>{opt.title}</h3>
          <p>{opt.body}</p>
        </article>
      ))}
    </div>

    <p class="fencing reveal">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M10 2.2 3.5 4.8v4.4c0 4 2.8 7 6.5 8.6 3.7-1.6 6.5-4.6 6.5-8.6V4.8L10 2.2Z" stroke-linejoin="round"/>
        <path d="m7.2 10 2 2 3.6-3.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>{t.models.fencing}</span>
    </p>
  </div>
</section>

<style>
  .models {
    background: linear-gradient(180deg, rgba(14, 159, 110, 0.035), transparent 40%);
  }
  .options {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.2rem;
  }
  .option {
    padding: 1.7rem 1.5rem;
    border-top: 3px solid var(--green);
  }
  .option:nth-child(1) { border-top-color: var(--evergreen); }
  .option:nth-child(2) { border-top-color: var(--green); }
  .option:nth-child(3) { border-top-color: var(--green-strong); }
  .option:nth-child(4) { border-top-color: var(--evergreen); }
  .option h3 {
    font-size: 1.08rem;
    font-weight: 620;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }
  .option p {
    margin-top: 0.6rem;
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1.6;
  }
  .fencing {
    margin-top: clamp(2.2rem, 4vw, 3rem);
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    max-width: 780px;
    font-size: 0.95rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .fencing svg {
    width: 22px;
    height: 22px;
    flex: none;
    color: var(--green-strong);
    margin-top: 0.15rem;
  }
  @media (max-width: 1000px) {
    .options { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .options { grid-template-columns: 1fr; }
  }
</style>
