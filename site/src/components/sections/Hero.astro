---
import { Image } from 'astro:assets';
import webmail from '../../assets/webmail.png';

interface Props {
  lang: 'en' | 'fr';
  BASE: string;
  t: any;
}
const { BASE, t } = Astro.props;
const REPO = 'https://github.com/cyril-belin/HermodMail';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <div class="intro reveal">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 id="hero-title" class="display" set:html={t.hero.title} />
      <p class="lead">{t.hero.lead}</p>
      <div class="ctas">
        <a class="btn btn-solid" href={REPO} target="_blank" rel="noopener">
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          {t.hero.ctaPrimary}
        </a>
        <a class="btn btn-ghost" href="#why">{t.hero.ctaSecondary}</a>
      </div>
    </div>

    <figure class="shot-frame reveal" style="--reveal-delay: 0.15s">
      <div class="chrome" aria-hidden="true">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        <span class="url mono">hermodmail · your server</span>
      </div>
      <Image
        src={webmail}
        alt={t.hero.shotCaption}
        widths={[480, 768, 1080, 1440]}
        sizes="(max-width: 1080px) 96vw, 1080px"
        loading="eager"
        fetchpriority="high"
        formats={['avif', 'webp']}
        quality={80}
      />
    </figure>
    <p class="caption reveal">{t.hero.shotCaption}</p>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(7.5rem, 14vh, 10.5rem);
    padding-bottom: var(--space-section);
    position: relative;
    overflow: clip;
  }
  /* faint dispatch lines behind the headline */
  .hero::before {
    content: '';
    position: absolute;
    top: -120px;
    right: -80px;
    width: 560px;
    height: 560px;
    background:
      radial-gradient(closest-side, rgba(14, 159, 110, 0.1), transparent 72%);
    pointer-events: none;
  }
  .intro { max-width: 820px; }
  h1.display {
    font-size: clamp(2.7rem, 6.4vw, 4.7rem);
    margin-top: 1.4rem;
  }
  .lead { margin-top: 1.4rem; }
  .ctas {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-top: 2.2rem;
  }
  .shot-frame {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: linear-gradient(#f3f1ec, #eceae4);
    border-bottom: 1px solid var(--hairline);
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #d6d3cc;
  }
  .dot:first-child { background: #e8b4ae; }
  .dot:nth-child(2) { background: #e6d3a8; }
  .dot:nth-child(3) { background: #b5d6b0; }
  .url {
    margin-inline: auto;
    font-size: 0.72rem;
    color: var(--faint);
    background: rgba(255, 255, 255, 0.65);
    border: 1px solid var(--hairline);
    padding: 2px 14px;
    border-radius: 99px;
    letter-spacing: 0.02em;
  }
  .caption {
    margin-top: 1.1rem;
    text-align: center;
    font-size: 0.88rem;
    color: var(--faint);
  }
</style>
