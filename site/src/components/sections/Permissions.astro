---
import { Image } from 'astro:assets';
import mcpTokens from '../../assets/mcp-tokens.png';

interface Props { t: any; }
const { t } = Astro.props;
---

<section class="section" id="permissions" aria-labelledby="perm-title">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">{t.permissions.eyebrow}</p>
      <h2 id="perm-title" class="h2">{t.permissions.title}</h2>
      <p class="lead">{t.permissions.lead}</p>
    </div>

    <div class="grid">
      <ul class="scopes reveal">
        {t.permissions.scopes.map((s) => (
          <li>
            <code class="scope mono">{s.scope}</code>
            <p>{s.body}</p>
          </li>
        ))}
      </ul>

      <div class="side">
        <div class="card lifecycle reveal">
          <h3>{t.permissions.lifecycleTitle}</h3>
          {t.permissions.lifecycle.map((item) => (
            <div class="lifecycle-item">
              <h4>{item.title}</h4>
              <p>{item.body}</p>
            </div>
          ))}
        </div>

        <figure class="reveal">
          <div class="shot">
            <Image
              src={mcpTokens}
              alt={t.permissions.shotCaption}
              widths={[480, 768, 1080]}
              sizes="(max-width: 980px) 96vw, 520px"
              formats={['avif', 'webp']}
              quality={80}
              loading="lazy"
            />
          </div>
          <figcaption>{t.permissions.shotCaption}</figcaption>
        </figure>
      </div>
    </div>

    <p class="honesty reveal">{t.permissions.honesty}</p>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }
  .scopes {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .scopes li {
    display: grid;
    grid-template-columns: 132px 1fr;
    gap: 1.1rem;
    align-items: baseline;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--hairline);
  }
  .scopes li:last-child { border-bottom: none; }
  .scope {
    background: var(--green-tint);
    font-size: 0.84rem;
    text-align: center;
  }
  .scopes p {
    font-size: 0.94rem;
    color: var(--muted);
    line-height: 1.55;
  }
  .lifecycle {
    padding: 1.7rem 1.6rem;
  }
  .lifecycle h3 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin-bottom: 1.2rem;
  }
  .lifecycle-item {
    padding: 0.9rem 0;
    border-top: 1px solid var(--hairline);
  }
  .lifecycle-item h4 {
    font-size: 0.99rem;
    font-weight: 620;
    letter-spacing: -0.01em;
  }
  .lifecycle-item h4::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    margin-right: 0.6em;
    vertical-align: 1px;
  }
  .lifecycle-item p {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.58;
  }
  figure figcaption {
    margin-top: 0.9rem;
    font-size: 0.85rem;
    color: var(--faint);
    text-align: center;
  }
  figure { margin-top: 1.6rem; }
  .honesty {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding: 1.4rem 1.7rem;
    border: 1px solid var(--hairline);
    border-left: 3px solid var(--evergreen);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--paper-raise);
    font-size: 0.98rem;
    color: var(--ink-soft);
    max-width: 820px;
  }
  @media (max-width: 980px) {
    .grid { grid-template-columns: 1fr; }
    .scopes li { grid-template-columns: 116px 1fr; }
  }
  @media (max-width: 480px) {
    .scopes li { grid-template-columns: 1fr; gap: 0.4rem; }
    .scope { justify-self: start; }
  }
</style>
