---
interface Props { t: any; }
const { t } = Astro.props;
---

<section class="section" id="why" aria-labelledby="why-title">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">{t.problem.eyebrow}</p>
      <h2 id="why-title" class="h2">{t.problem.title}</h2>
      <p class="lead">{t.problem.lead}</p>
    </div>

    <blockquote class="principle reveal">
      <p>{t.problem.principle}</p>
    </blockquote>

    <div class="cards">
      {t.problem.cards.map((card, i) => (
        <article class="card reveal" style={`--reveal-delay: ${i * 0.08}s`}>
          <span class="num mono" aria-hidden="true">0{i + 1}</span>
          <h3>{card.title}</h3>
          <p>{card.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .principle {
    margin: 0 0 clamp(2.5rem, 5vw, 3.5rem);
    padding: 1.6rem 2rem;
    border-left: 3px solid var(--green);
    background: linear-gradient(90deg, var(--green-tint), transparent 85%);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .principle p {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.6vw, 1.8rem);
    line-height: 1.3;
    color: var(--evergreen);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.3rem;
  }
  .card {
    padding: 1.9rem 1.7rem;
  }
  .num {
    font-size: 0.78rem;
    color: var(--green-strong);
    letter-spacing: 0.1em;
  }
  .card h3 {
    font-size: 1.16rem;
    font-weight: 620;
    line-height: 1.35;
    margin-top: 0.8rem;
    letter-spacing: -0.01em;
  }
  .card p {
    margin-top: 0.7rem;
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.6;
  }
  @media (max-width: 900px) {
    .cards { grid-template-columns: 1fr; }
  }
</style>
