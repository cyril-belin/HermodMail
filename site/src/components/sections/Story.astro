---
import { Image } from 'astro:assets';
import agentDrafts from '../../assets/agent-drafts.png';

interface Props { t: any; }
const { t } = Astro.props;
---

<section class="section story" id="how" aria-labelledby="how-title">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">{t.story.eyebrow}</p>
      <h2 id="how-title" class="h2">{t.story.title}</h2>
      <p class="lead">{t.story.lead}</p>
    </div>

    <div class="grid">
      <ol class="steps">
        {t.story.steps.map((step, i) => (
          <li class="step reveal" style={`--reveal-delay: ${i * 0.05}s`}>
            <span class="marker mono" aria-hidden="true">
              <span class="idx">0{i + 1}</span>
            </span>
            <div class="step-body">
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <figure class="sticky-shot">
        <div class="shot reveal">
          <Image
            src={agentDrafts}
            alt={t.story.shotCaption}
            widths={[480, 768, 1080]}
            sizes="(max-width: 980px) 96vw, 560px"
            formats={['avif', 'webp']}
            quality={80}
            loading="lazy"
          />
        </div>
        <figcaption class="reveal">{t.story.shotCaption}</figcaption>
      </figure>
    </div>

    <blockquote class="quote reveal">
      <p>{t.story.quote}</p>
    </blockquote>
  </div>
</section>

<style>
  .story {
    background:
      linear-gradient(180deg, transparent, rgba(14, 159, 110, 0.035) 30%, transparent);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.4rem;
    position: relative;
    padding-bottom: 2.6rem;
  }
  .step:last-child { padding-bottom: 0; }
  /* connector line */
  .step::before {
    content: '';
    position: absolute;
    left: 21px;
    top: 48px;
    bottom: 6px;
    width: 2px;
    background: var(--hairline);
  }
  .step:last-child::before { display: none; }
  .step::after {
    content: '';
    position: absolute;
    left: 21px;
    top: 48px;
    bottom: 6px;
    width: 2px;
    background: var(--green);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.8s var(--ease) 0.3s;
  }
  .step.is-in::after { transform: scaleY(1); }
  .step:last-child::after { display: none; }

  .marker {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--paper-raise);
    border: 1.5px solid var(--green);
    color: var(--green-strong);
    display: grid;
    place-items: center;
    font-size: 0.8rem;
    font-weight: 500;
    flex: none;
    z-index: 1;
    transition: background 0.4s var(--ease), color 0.4s var(--ease);
  }
  .step.is-in .marker {
    background: var(--evergreen);
    color: var(--snow);
    border-color: var(--evergreen);
  }
  .step-body h3 {
    font-size: 1.25rem;
    font-weight: 620;
    letter-spacing: -0.01em;
    padding-top: 0.45rem;
  }
  .step-body p {
    margin-top: 0.55rem;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.62;
    max-width: 46ch;
  }
  .sticky-shot {
    position: sticky;
    top: 96px;
  }
  .sticky-shot figcaption {
    margin-top: 1rem;
    font-size: 0.86rem;
    color: var(--faint);
    text-align: center;
  }
  .quote {
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
    text-align: center;
  }
  .quote p {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.8vw, 2.7rem);
    line-height: 1.2;
    color: var(--evergreen);
    max-width: 24ch;
    margin-inline: auto;
    text-wrap: balance;
  }
  .quote p::before {
    content: '— ';
    color: var(--green);
  }
  @media (max-width: 980px) {
    .grid { grid-template-columns: 1fr; }
    .sticky-shot { position: static; order: -1; }
    .quote p { max-width: none; }
  }
</style>
