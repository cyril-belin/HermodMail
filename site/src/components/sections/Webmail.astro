---
import { Image } from 'astro:assets';
import webmail from '../../assets/webmail.png';
import composeDraft from '../../assets/compose-draft.png';
import darkTheme from '../../assets/dark-theme.png';

interface Props { t: any; }
const { t } = Astro.props;

const shots = [
  { label: t.webmail.gallery[0].label, caption: t.webmail.gallery[0].caption, src: webmail },
  { label: t.webmail.gallery[1].label, caption: t.webmail.gallery[1].caption, src: composeDraft },
  { label: t.webmail.gallery[2].label, caption: t.webmail.gallery[2].caption, src: darkTheme },
];
---

<section class="section" id="webmail" aria-labelledby="webmail-title">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">{t.webmail.eyebrow}</p>
      <h2 id="webmail-title" class="h2" set:html={t.webmail.title} />
      <p class="lead">{t.webmail.lead}</p>
    </div>

    <div class="feature-grid reveal">
      {t.webmail.features.map((f) => (
        <div class="feature">
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </div>
      ))}
    </div>

    <div class="gallery reveal" role="group" aria-label={t.webmail.galleryLabel}>
      <div class="tabs" role="tablist" aria-label={t.webmail.galleryLabel}>
        {shots.map((s, i) => (
          <button
            class="tab"
            role="tab"
            id={`tab-shot-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`panel-shot-${i}`}
            tabindex={i === 0 ? 0 : -1}
            type="button"
          >
            {s.label}
          </button>
        ))}
      </div>

      {shots.map((s, i) => (
        <div
          class="panel"
          role="tabpanel"
          id={`panel-shot-${i}`}
          aria-labelledby={`tab-shot-${i}`}
          hidden={i !== 0}
        >
          <div class="shot">
            <Image
              src={s.src}
              alt={s.caption}
              widths={[480, 768, 1080, 1440]}
              sizes="(max-width: 1080px) 96vw, 1080px"
              formats={['avif', 'webp']}
              quality={80}
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          </div>
          <p class="caption">{s.caption}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const gallery = document.querySelector<HTMLElement>('.gallery');
  if (gallery) {
    const tabs = [...gallery.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...gallery.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const select = (index: number) => {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        panels[i].hidden = !active;
      });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        let next = -1;
        if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
        if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
        if (e.key === 'Home') next = 0;
        if (e.key === 'End') next = tabs.length - 1;
        if (next >= 0) {
          e.preventDefault();
          select(next);
          tabs[next].focus();
        }
      });
    });
  }
</script>

<style>
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }
  .feature {
    background: var(--paper-raise);
    padding: 1.5rem 1.4rem;
  }
  .feature h3 {
    font-family: var(--font-mono);
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--evergreen);
    letter-spacing: -0.01em;
  }
  .feature p {
    margin-top: 0.5rem;
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .tabs {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 1.2rem;
  }
  .tab {
    padding: 0.55em 1.1em;
    border-radius: 999px;
    border: 1px solid var(--hairline-strong);
    font-size: 0.9rem;
    font-weight: 550;
    color: var(--muted);
    background: var(--paper-raise);
    transition: all 0.2s var(--ease);
  }
  .tab:hover { border-color: var(--ink); color: var(--ink); }
  .tab[aria-selected='true'] {
    background: var(--evergreen);
    border-color: var(--evergreen);
    color: var(--snow);
  }
  .caption {
    margin-top: 1rem;
    text-align: center;
    font-size: 0.88rem;
    color: var(--faint);
  }
  @media (max-width: 1000px) {
    .feature-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .feature-grid { grid-template-columns: 1fr; }
  }
</style>
