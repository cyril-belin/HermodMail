---
interface Props { t: any; }
const { t } = Astro.props;
const d = t.mcp.diagram;

const toolGroups = t.mcp.toolGroups;
---

<section class="section mcp" id="mcp" aria-labelledby="mcp-title">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">{t.mcp.eyebrow}</p>
      <h2 id="mcp-title" class="h2">{t.mcp.title}</h2>
      <p class="lead">{t.mcp.lead}</p>
    </div>

    <figure class="diagram card reveal" role="img" aria-label={d.caption}>
      <div class="dia">
        <div class="col sources">
          <div class="node">
            <span class="node-title">{d.ui}</span>
            <span class="node-note">{d.uiNote}</span>
          </div>
          <div class="flow" aria-hidden="true"></div>
          <div class="node agent">
            <span class="node-title mono">{d.agents}</span>
            <span class="node-note">{d.agentsNote}</span>
          </div>
        </div>

        <div class="flow main" aria-hidden="true"></div>

        <div class="node engine">
          <span class="node-title">{d.engine}</span>
          <span class="node-note">{d.engineNote}</span>
        </div>

        <div class="flow main" aria-hidden="true"></div>

        <div class="col sinks">
          <div class="node">
            <span class="node-title mono">{d.imap} · {d.smtp}</span>
          </div>
          <div class="flow" aria-hidden="true"></div>
          <div class="node soft">
            <span class="node-title">{d.ai}</span>
            <span class="node-note">{d.aiNote}</span>
          </div>
        </div>
      </div>
      <figcaption>{d.caption}</figcaption>
    </figure>

    <div class="tools">
      <div class="tools-head reveal">
        <h3>{t.mcp.toolsTitle}</h3>
        <p>{t.mcp.toolsLead}</p>
      </div>
      <div class="groups reveal">
        {toolGroups.map((group: any, gi: number) => (
          <div class="group" style={`--gi: ${gi}`}>
            <span class="scope mono">{group.scope}</span>
            <ul>
              {group.tools.map((tool: string) => (
                <li class="mono">{tool}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="tools-note reveal">{t.mcp.toolsNote}</p>
    </div>
  </div>
</section>

<style>
  .mcp {
    background: var(--evergreen-deep);
    color: var(--snow);
  }
  .mcp .eyebrow { color: #4fd1a5; }
  .mcp .h2 { color: var(--snow); }
  .mcp .h2 em { color: #4fd1a5; }
  .mcp .lead { color: var(--snow-muted); }
  .section + .section.mcp { border-top: none; }

  /* ---- diagram ---- */
  .diagram {
    background: rgba(244, 242, 236, 0.035);
    border: 1px solid var(--snow-faint);
    box-shadow: none;
    padding: clamp(1.6rem, 4vw, 3rem);
    margin-bottom: clamp(3.5rem, 7vw, 5.5rem);
  }
  .dia {
    display: grid;
    grid-template-columns: 1fr auto 1.25fr auto 1fr;
    align-items: stretch;
    gap: clamp(0.6rem, 2vw, 1.4rem);
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: clamp(1.4rem, 3vw, 2.4rem);
  }
  .node {
    border: 1px solid var(--snow-faint);
    border-radius: var(--radius-sm);
    padding: 0.95rem 1.1rem;
    display: grid;
    gap: 0.25rem;
    background: rgba(244, 242, 236, 0.05);
    flex: 1;
    justify-content: center;
    align-content: center;
    text-align: center;
  }
  .node-title {
    font-weight: 600;
    font-size: 0.98rem;
    letter-spacing: -0.01em;
    color: var(--snow);
  }
  .node-note {
    font-size: 0.78rem;
    color: var(--snow-muted);
  }
  .engine {
    background: var(--snow);
    border-color: var(--snow);
    color: var(--evergreen-deep);
    display: grid;
    place-content: center;
    text-align: center;
    padding: 2rem 1.6rem;
  }
  .engine .node-title { color: var(--evergreen); font-size: 1.08rem; }
  .engine .node-note { color: rgba(12, 59, 46, 0.65); }
  .node.soft { border-style: dashed; }

  .flow {
    width: clamp(26px, 5vw, 54px);
    height: 2px;
    align-self: center;
    background: repeating-linear-gradient(
      90deg,
      #4fd1a5 0 6px,
      transparent 6px 12px
    );
    background-size: 12px 2px;
    animation: flow 0.9s linear infinite;
    position: relative;
  }
  .flow::after {
    content: '';
    position: absolute;
    right: -1px;
    top: -3.5px;
    border: solid #4fd1a5;
    border-width: 0 2px 2px 0;
    padding: 3px;
    transform: rotate(-45deg);
  }
  @keyframes flow {
    to { background-position: 12px 0; }
  }

  figcaption {
    margin-top: 1.4rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--snow-muted);
  }

  /* ---- tool surface ---- */
  .tools-head h3 {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 400;
    color: var(--snow);
  }
  .tools-head p {
    margin-top: 0.7rem;
    color: var(--snow-muted);
    max-width: 58ch;
    font-size: 0.98rem;
  }
  .groups {
    margin-top: 2.2rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--snow-faint);
    border: 1px solid var(--snow-faint);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .group {
    background: var(--evergreen-deep);
    padding: 1.3rem 1.5rem;
  }
  .scope {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 500;
    color: #4fd1a5;
    background: rgba(79, 209, 165, 0.1);
    border: 1px solid rgba(79, 209, 165, 0.25);
    padding: 0.2em 0.7em;
    border-radius: 99px;
  }
  .group ul {
    list-style: none;
    padding: 0;
    margin-top: 0.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .group li {
    font-size: 0.82rem;
    color: var(--snow-muted);
    background: rgba(244, 242, 236, 0.06);
    border: 1px solid var(--snow-faint);
    padding: 0.28em 0.65em;
    border-radius: 6px;
  }
  .tools-note {
    margin-top: 1.4rem;
    font-size: 0.85rem;
    color: rgba(244, 242, 236, 0.45);
  }

  @media (max-width: 900px) {
    .dia {
      grid-template-columns: 1fr;
      gap: 0;
      justify-items: center;
    }
    .col { width: 100%; gap: 0; }
    .flow, .flow.main {
      width: 2px;
      height: clamp(24px, 4vw, 34px);
      background: repeating-linear-gradient(
        180deg,
        #4fd1a5 0 6px,
        transparent 6px 12px
      );
      background-size: 2px 12px;
      animation-name: flow-v;
    }
    .flow::after {
      right: auto;
      left: -3.5px;
      top: auto;
      bottom: -1px;
      transform: rotate(45deg);
    }
    @keyframes flow-v {
      to { background-position: 0 12px; }
    }
    .flow.main { width: 2px; height: clamp(24px, 4vw, 34px); }
    .engine { width: 100%; padding: 1.4rem 1rem; }
    .col .node { width: 100%; }
    .groups { grid-template-columns: 1fr; }
  }
</style>
