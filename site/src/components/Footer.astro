---
import BrandMark from './BrandMark.astro';

interface Props {
  lang: 'en' | 'fr';
  BASE: string;
  t: any;
}
const { lang, BASE, t } = Astro.props;
const REPO = 'https://github.com/cyril-belin/HermodMail';
---

<footer class="site-footer">
  <div class="wrap grid">
    <div class="brand-col">
      <a class="brand" href={BASE + '/'} aria-label="HermodMail — home">
        <BrandMark />
        <span>HermodMail</span>
      </a>
      <p class="tagline">{t.footer.tagline}</p>
      <p class="myth">{t.conclusion.myth}</p>
    </div>

    <nav aria-label={t.footer.sections.site}>
      <h3>{t.footer.sections.site}</h3>
      <ul>
        <li><a href="#why">{t.footer.links.features}</a></li>
        <li><a href="#permissions">{t.footer.links.permissions}</a></li>
        <li><a href="#developers">{t.footer.links.developers}</a></li>
      </ul>
    </nav>

    <nav aria-label={t.footer.sections.project}>
      <h3>{t.footer.sections.project}</h3>
      <ul>
        <li><a href={REPO} target="_blank" rel="noopener">{t.footer.links.github}</a></li>
        <li><a href={`${REPO}/issues`} target="_blank" rel="noopener">{t.footer.links.issues}</a></li>
      </ul>
    </nav>

    <nav aria-label={t.footer.sections.legal}>
      <h3>{t.footer.sections.legal}</h3>
      <ul>
        <li><a href={`${REPO}/blob/main/LICENSE`} target="_blank" rel="noopener">{t.footer.links.license}</a></li>
        <li class="lang-footer">
          <a href={BASE + '/'} data-lang="en">EN</a> · <a href={`${BASE}/fr/`} data-lang="fr">FR</a>
        </li>
      </ul>
    </nav>
  </div>

  <div class="wrap bottom">
    <p>{t.footer.note}</p>
    <p>{t.footer.copyright}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--evergreen-deep);
    color: var(--snow-muted);
    padding: 4.5rem 0 2.5rem;
  }
  .grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem;
  }
  .brand { color: var(--snow); }
  .brand .mark {
    background: var(--snow);
    border-radius: 7px;
  }
  .tagline {
    margin-top: 1.1rem;
    font-size: 0.95rem;
    color: var(--snow);
    max-width: 30ch;
  }
  .myth {
    margin-top: 0.9rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.02rem;
    line-height: 1.5;
    max-width: 34ch;
    color: rgba(244, 242, 236, 0.5);
  }
  h3 {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(244, 242, 236, 0.45);
    margin-bottom: 1.1rem;
  }
  ul { list-style: none; padding: 0; display: grid; gap: 0.7rem; }
  a {
    color: var(--snow-muted);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s;
  }
  a:hover { color: var(--snow); }
  .lang-footer a { font-family: var(--font-mono); font-size: 0.85rem; }
  .bottom {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--snow-faint);
    margin-top: 3.5rem;
    padding-top: 1.6rem;
    font-size: 0.82rem;
    color: rgba(244, 242, 236, 0.4);
  }
  @media (max-width: 820px) {
    .grid { grid-template-columns: 1fr 1fr; }
    .brand-col { grid-column: 1 / -1; }
  }
</style>

